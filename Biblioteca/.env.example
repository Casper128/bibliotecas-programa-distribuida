# Credenciales de ejemplo para desarrollo local.
POSTGRES_HOST=localhost
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=library_dev_only
POSTGRES_PORT=5433

# API ejecutada en el equipo, PostgreSQL ejecutado en Docker.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS="https://localhost:7240;http://localhost:5240"
ConnectionStrings__MyConnection="Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
